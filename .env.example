# Variables para docker-compose. Copiar a .env y definir una contraseña propia.
APP_PORT=8000

# Contraseña del rol de la aplicación (minisuper_app)
DB_PASSWORD=
# Contraseña del rol dueño del esquema (minisuper_owner), que corre las migraciones.
# También es la del superusuario postgres del contenedor.
DB_ADMIN_PASSWORD=
# Puerto en la compu para PostgreSQL de Docker (5433 para no chocar con un PostgreSQL local en 5432)
DB_FORWARD_PORT=5433
