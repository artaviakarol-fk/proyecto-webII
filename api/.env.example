# Fiado: límite base por cliente, en colones (confirmado con el dueño)
LIMITE_FIADO_BASE=90000
# Tope del límite contando las ampliaciones de emergencia del cajero
LIMITE_FIADO_MAXIMO=120000

# IA (US-308): clave de la API de Gemini (Google AI Studio) para el borrador de venta desde texto libre.
# Sin clave, el borrador responde 503 y la venta se registra a mano.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Modelos de respaldo, separados por coma, si el principal está saturado (error 503).
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Pagos: pasarela activa y credenciales de PRUEBA (nunca llaves reales)
PAYMENT_GATEWAY=onvo
ONVO_SECRET_KEY=
ONVO_PUBLISHABLE_KEY=
ONVO_WEBHOOK_SECRET=
# ONVO_BASE_URL=https://api.onvopay.com/v1
# ONVO_SINPE_NUMBER=+50670196686
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# PAYPAL_COLONES_PER_DOLLAR=500
# PAYPAL_RETURN_URL=
# PAYPAL_CANCEL_URL=

# Alquiler de la plataforma (colones por mes y días de prueba, de aviso y de gracia)
# PLATAFORMA_PRECIO_MENSUAL=15000
# PLATAFORMA_DIAS_PRUEBA=5
# PLATAFORMA_DIAS_AVISO=7
# PLATAFORMA_DIAS_GRACIA=3

# Tiempo real (Reverb). La clave es pública (la usa el cliente Vue); el secreto nunca sale del servidor.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Opcionales del servidor de Reverb (los valores por defecto sirven para una sola instancia):
# REVERB_SERVER=
# REVERB_SERVER_HOST=
# REVERB_SERVER_PORT=
# REVERB_SERVER_PATH=
# REVERB_MAX_REQUEST_SIZE=
# REVERB_SCALING_ENABLED=
# REVERB_SCALING_CHANNEL=
# REDIS_TIMEOUT=
# REVERB_PULSE_INGEST_INTERVAL=
# REVERB_TELESCOPE_INGEST_INTERVAL=
